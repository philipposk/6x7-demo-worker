# The worker reaches the DB via Supabase RPCs with the secret key — no Postgres
# connection string needed. Secret key = Supabase → Settings → API keys → secret
# (the sb_secret_... key; it bypasses RLS).
SUPABASE_URL=https://fmrnqepyyjucnfbrqawl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional: passed through to demo-pipeline for LLM narration + premium voices.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

POLL_INTERVAL_MS=5000
TOOLS_DIR=/tools
