# Postgres connection string for the 6x7 project (Supabase → Settings → Database
# → Connection string → URI; use the pooler/session string). Gives the worker
# direct access to the demo schema (which isn't exposed over REST).
DATABASE_URL=postgres://postgres:<pw>@<host>:5432/postgres

# For uploading finished renders to the public demo-output storage bucket.
SUPABASE_URL=https://fmrnqepyyjucnfbrqawl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional: passed through to demo-pipeline for LLM narration + premium voices.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

POLL_INTERVAL_MS=5000
TOOLS_DIR=/tools
